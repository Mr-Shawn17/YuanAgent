# ============================ 前端（Next.js）============================
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# ============================ 运行时数据 / 本地敏感配置 ============================
# data/ 下的 workspace（文件工具沙箱）与 kb_stub 均为运行时生成/本地数据，不上传；
# 仅保留 data/kb_stub/chunks.json 作为 stub 示例知识库供参考。
data/workspace/
data/kb_stub/*
!data/kb_stub/chunks.json

# 真实配置含本地密码等敏感信息，忽略；仓库里放 config/agent.yaml.example 供参考
config/agent.yaml

# 环境变量 / 密钥（绝不提交任何真实密钥）
.env
.env.*
!.env.example
*.local

