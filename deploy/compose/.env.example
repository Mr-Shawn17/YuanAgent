# deploy/compose/.env.example —— 复制为 .env 后填写（.env 不入库）
GLM_API_KEY=填入你的GLM密钥

# Windows 宿主 IP（backend 容器 → Docker Desktop MySQL）。
# 在 Ubuntu2204 内探测；WSL 重启后可能漂移（T06 坑 6），漂移后更新本文件并 compose up -d：
#   ip route show default | awk '{print $3}'
WINDOWS_HOST_IP=172.28.144.1

# Engine（Ubuntu2204）docker 组 GID——docker.sock 的属主组，容器内 appuser 按此入组：
#   getent group docker | cut -d: -f3
DOCKER_GID=999
