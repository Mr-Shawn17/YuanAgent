# Langfuse 自托管环境变量模板（可提交版本，不含真实密钥）
# 复制为 deploy/langfuse/.env 后填入强随机值（openssl rand -hex 16 / 32）

# ==== 核心加密与签名（必填）====
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME

# ==== 面板访问地址（Web 端口 3030）====
NEXTAUTH_URL=http://localhost:3030

# ==== 数据库与中间件密码 ====
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME

# ==== 数据库连接串（Langfuse 用它连 Postgres，密码需与 POSTGRES_PASSWORD 一致）====
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000

# ==== MinIO（媒体/blob 存储）====
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

# ==== Headless 初始化：首次启动自动创建账号/组织/项目（无需 UI 手动注册）====
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
LANGFUSE_INIT_ORG_ID=CHANGEME-org
LANGFUSE_INIT_ORG_NAME=CHANGEME
LANGFUSE_INIT_PROJECT_ID=CHANGEME-project
LANGFUSE_INIT_PROJECT_NAME=CHANGEME

# ==== Langfuse API Keys（后端接入用，关键！）====
# 若走 headless 初始化，用下面两个 INIT 变量预置 project 的 key（public/secret 需成对一致）；
# 否则在面板 Project 设置里手动生成后，把 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 填进 config/agent.yaml。
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
